{
    "name": "laravel-lang/currency-names",
    "description": "The project contains native translations of currency names",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel-lang",
        "i18n",
        "locales",
        "localization",
        "translation",
        "translations",
        "currency"
    ],
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://laravel-lang.com"
        }
    ],
    "support": {
        "source": "https://github.com/Laravel-Lang/mona"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/support": "^12.0 || ^13.0 || dev-master",
        "laravel-lang/config": "self.version",
        "laravel-lang/exceptions": "self.version",
        "laravel-lang/filesystem": "self.version",
        "laravel-lang/library": "self.version",
        "laravel-lang/locale-list": "self.version",
        "symfony/polyfill-php86": "^1.43"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LaravelLang\\CurrencyNames\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
