{
    "name": "laravel-lang/mona",
    "description": "Easily connect the necessary language packs to the application",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel-lang",
        "i18n",
        "languages",
        "translations"
    ],
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro",
            "homepage": "https://dragon-code.pro"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://laravel-lang.com"
        }
    ],
    "homepage": "https://laravel-lang.com",
    "support": {
        "issues": "https://github.com/Laravel-Lang/mona/issues",
        "source": "https://github.com/Laravel-Lang/mona"
    },
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-zip": "*",
        "brick/varexporter": "^0.7",
        "laravel/prompts": "^0.3.26",
        "league/commonmark": "^2.10.7",
        "symfony/console": "^7.4 || ^8.1",
        "symfony/polyfill-php86": "^1.43"
    },
    "require-dev": {
        "composer/class-map-generator": "^1.9",
        "composer/semver": "^3.6",
        "dragon-code/benchmark": "^4.6",
        "driftingly/rector-laravel": "^2.7",
        "ergebnis/composer-normalize": "^2.57",
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0 || ^11.3",
        "pestphp/pest": "^4.7.8 || ^5.3.5",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0",
        "symfony/var-dumper": "^7.4 || ^8.1"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LaravelLang\\Config\\": "src/Config/src/",
            "LaravelLang\\CountryNames\\": "src/CountryNames/src/",
            "LaravelLang\\CurrencyNames\\": "src/CurrencyNames/src/",
            "LaravelLang\\Exceptions\\": "src/Exceptions/src/",
            "LaravelLang\\Filesystem\\": "src/Filesystem/src/",
            "LaravelLang\\JsonFallback\\": "src/JsonFallback/src/",
            "LaravelLang\\LocaleList\\": "src/LocaleList/src/",
            "LaravelLang\\LocaleNames\\": "src/LocaleNames/src/",
            "LaravelLang\\Locales\\": "src/Locales/src/",
            "LaravelLang\\Models\\": "src/Models/src/",
            "LaravelLang\\Publisher\\": "src/Publisher/src/",
            "LaravelLang\\Routes\\": "src/Routes/src/",
            "LaravelLang\\Toolkit\\": "src/Toolkit/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/",
            "Workbench\\Package\\": "workbench/package/"
        },
        "files": [
            "src/Routes/src/helpers.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "laravel/pint": true,
            "pestphp/pest-plugin": true
        },
        "policy": {
            "abandoned": {
                "block": false,
                "audit": "report"
            },
            "cooldown": {
                "period": "3 days"
            }
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "style": [
            "@composer normalize",
            "@composer normalize src/Actions/composer.json",
            "@composer normalize src/Attributes/composer.json",
            "@composer normalize src/Common/composer.json",
            "@composer normalize src/Config/composer.json",
            "@composer normalize src/CountryNames/composer.json",
            "@composer normalize src/CurrencyNames/composer.json",
            "@composer normalize src/Exceptions/composer.json",
            "@composer normalize src/Filesystem/composer.json",
            "@composer normalize src/HttpStatuses/composer.json",
            "@composer normalize src/JsonFallback/composer.json",
            "@composer normalize src/Lang/composer.json",
            "@composer normalize src/Library/composer.json",
            "@composer normalize src/LocaleList/composer.json",
            "@composer normalize src/LocaleNames/composer.json",
            "@composer normalize src/Locales/composer.json",
            "@composer normalize src/Models/composer.json",
            "@composer normalize src/MoonShine/composer.json",
            "@composer normalize src/Publisher/composer.json",
            "@composer normalize src/Routes/composer.json",
            "@composer normalize src/StarterKits/composer.json",
            "@composer normalize src/Toolkit/composer.json",
            "@composer normalize src/TranslationsTemplate/composer.json",
            "@php vendor/bin/rector --ansi",
            "@php vendor/bin/pint --parallel --ansi"
        ],
        "test": "@php vendor/bin/pest --parallel",
        "test:coverage": "@php -d xdebug.mode=coverage vendor/bin/pest --coverage --min=99",
        "test:types": "@php vendor/bin/phpstan analyse --memory-limit=-1"
    }
}
